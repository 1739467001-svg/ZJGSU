# ---- Phase 2 (数字孪生 / live data) ----
# Copy to `.env.local` and fill in to connect the real Flask v2 API.
# Only needed once you enable fetchLiveBookings() in src/data/source.ts.

# Base URL of the meeting-room backend (Flask v2), e.g. https://116.62.x.x
VITE_API_BASE=

# v2 API key sent as the X-API-Key header
VITE_API_KEY=
